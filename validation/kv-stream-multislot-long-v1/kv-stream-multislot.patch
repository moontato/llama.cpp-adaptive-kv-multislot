+#!/usr/bin/env python3
+"""Build and test the pinned adaptive-KV patch entirely under /mnt/ramdisk."""
+
+import argparse
+import csv
+import concurrent.futures
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import signal
+import socket
+import subprocess
+import sys
+import tarfile
